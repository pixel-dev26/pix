# ============================================================================
# HOST: SiteGround — NGINX in front of Apache
# ----------------------------------------------------------------------------
# READ THIS BEFORE TRUSTING ANYTHING BELOW.
#
# SiteGround's NGINX Direct Delivery serves static files straight from NGINX and
# never consults Apache for them. RewriteRule, Redirect and ErrorDocument decide
# which file answers a URL and still work. Header, ExpiresByType and AddType
# modify a response Apache is no longer producing, and are silently dropped.
#
# Measured against the live site, 10 Aug 2026 — these values were already in the
# deployed file and none of them arrived:
#
#     directive                       served instead
#     Cache-Control css 604800        max-age=31536000
#     Cache-Control txt 216000        max-age=15552000
#     X-Content-Type-Options nosniff  header absent
#     X-Frame-Options SAMEORIGIN      header absent
#     Strict-Transport-Security       header absent
#     Content-Security-Policy         header absent
#
# TURN NGINX DIRECT DELIVERY OFF in Site Tools > Speed > Caching. Until you do:
#   - the security headers and CSP below do nothing,
#   - every .md mirror is served as application/octet-stream and DOWNLOADS
#     instead of rendering, and
#   - the X-Robots-Tag that keeps those 34 mirrors out of the index is dropped,
#     leaving a duplicate of every page on the domain crawlable and indexable.
#
# The rewrite rules are unaffected either way.
# ============================================================================

# BEGIN HTML

RewriteEngine on

# ============================================================================
# MACHINE LAYER — /ai and the .md mirrors
# ============================================================================

# /ai used to be a FILE (ai.html) sharing its name with the ai/ directory, which
# needed a rewrite here plus DirectorySlash Off in ai/.htaccess to stop mod_dir
# 301-ing /ai to /ai/. That whole arrangement is gone: the page is now
# ai/index.html, so Apache's ordinary directory handling serves /ai/ and adds the
# trailing slash to /ai by itself. No rule is needed, and the old one actively
# broke things twice over —
#   1. it rewrote to /ai.html, which no longer exists, so /ai/ answered 404;
#   2. the target was domain-absolute, so on a sub-path deployment
#      (pixelstreet.xyz/pix/) it pointed outside the deployment and 404'd even
#      while ai.html still existed.
# Serving it as a directory needs no rewrite at all, which is what makes it work
# from the domain root and from /pix/ alike. It also matches /blog/ai/, which has
# always been a directory. IF scripts/build-htaccess.mjs IS REGENERATED, THE
# ai/?$ RULE AND ai/.htaccess MUST NOT COME BACK.

# Apache has no MIME type for .md and falls back to application/octet-stream,
# which makes the browser DOWNLOAD the mirror instead of displaying it.
AddType text/markdown .md

# The mirrors are the same words as the pages they mirror. They must stay
# readable — that is what they are for — but must not compete with those pages
# in the index. noindex stops them being listed; follow keeps their links
# counting. See the SiteGround note at the top of this file: with NGINX Direct
# Delivery ON this header never reaches the response, and the mirrors become
# indexable duplicates of all 34 pages.
<FilesMatch "\.md$">
  <IfModule mod_headers.c>
    Header always set X-Robots-Tag "noindex, follow"
  </IfModule>
</FilesMatch>

# ============================================================================
# BLOG — static Astro build at /blog/. WordPress is gone.
# ----------------------------------------------------------------------------
# Everything in this block MUST come before the site-wide rules below, because
# those strip trailing slashes and rewrite .html — and the blog needs the
# opposite of both. The two halves of this domain genuinely disagree about
# trailing slashes: the site strips them (/about/ -> /about), the blog requires
# them (/blog/x -> /blog/x/). Keep the rules separate or you get a 301 loop.
# ============================================================================

# 0. Media. The uploads folder moved out of the WordPress install to /blog/media/,
#    keeping the year/month/filename suffix exactly — so ONE rule covers all 1,283
#    files instead of a rule each, and it also catches old URLs we no longer host
#    (orphaned thumbnail variants, images from deleted posts) that Google may still
#    have indexed. Those 301 and then 404, which is the honest answer.
#    This is the highest-traffic rule on the blog, so it goes first.
RewriteRule ^blog/wp-content/uploads/(.*)$ /blog/media/$1 [R=301,L]

# 1. WordPress leftovers. Nothing here exists any more; say so honestly rather
#    than letting them fall through to the static handler and 404 as HTML.
RewriteRule ^blog/wp-admin/?  - [G,L]
RewriteRule ^blog/wp-login\.php$ - [G,L]
RewriteRule ^blog/wp-json/ - [G,L]
RewriteRule ^blog/xmlrpc\.php$ - [G,L]
RewriteRule ^blog/wp-cron\.php$ - [G,L]

# 2. Paginated archives. /blog/page/N/ served byte-identical 200s for every N —
#    an infinite duplicate trap. The index carries all 65 posts and filters
#    client-side, so there is no page 2.
RewriteRule ^blog/page/ /blog/ [R=301,L]

# 3. The case-studies CPT duplicated the main site's own pages.
RewriteRule ^blog/case-studies/([^/]+)/?$ /case-studies/$1 [R=301,L]

# 4. Retired slugs and merged posts (generated from deploy/redirects.map).
RewriteRule ^blog/ssl-guide/?$ /blog/comprehensive-guide-to-ssl/ [R=301,L]
RewriteRule ^blog/designing-a-website-diy/?$ /blog/designing-a-website/ [R=301,L]
RewriteRule ^blog/advanced-keyword-research-guide-2023/?$ /blog/advanced-keyword-research-guide/ [R=301,L]
RewriteRule ^blog/seo-in-2023-and-beyond-the-evolution-and-future-of-search/?$ /blog/future-of-seo/ [R=301,L]
RewriteRule ^blog/top-10-seo-companies-in-kolkata/?$ /blog/best-seo-companies-in-kolkata/ [R=301,L]
RewriteRule ^blog/guide-to-local-seo-ranking-factors-map-pack-for-2024/?$ /blog/guide-to-local-seo-ranking-factors-map-pack/ [R=301,L]
RewriteRule ^blog/about-pixel-street-web-design-agency/?$ /web-design-company-kolkata [R=301,L]
RewriteRule ^blog/the-ultimate-seo-tutorial-step-by-step-guide/?$ /blog/step-by-step-seo-guide/ [R=301,L]
RewriteRule ^blog/the-ultimate-seo-tutorial-step-by-step-guide-2023/?$ /blog/step-by-step-seo-guide/ [R=301,L]
RewriteRule ^blog/the-evolution-and-future-of-seo-the-search-revolution/?$ /blog/future-of-seo/ [R=301,L]
RewriteRule ^blog/author/admin/?$ /blog/author/khurshid-alam/ [R=301,L]
RewriteRule ^blog/wp-sitemap\.xml$ /blog/sitemap.xml [R=301,L]
RewriteRule ^blog/wp-sitemap-posts-post-1\.xml$ /blog/sitemap.xml [R=301,L]
RewriteRule ^blog/wp-sitemap-posts-page-1\.xml$ /blog/sitemap.xml [R=301,L]
RewriteRule ^blog/wp-sitemap-taxonomies-category-1\.xml$ /blog/sitemap.xml [R=301,L]
RewriteRule ^blog/wp-sitemap-taxonomies-post_tag-1\.xml$ /blog/sitemap.xml [R=301,L]
RewriteRule ^blog/wp-sitemap-users-1\.xml$ /blog/sitemap.xml [R=301,L]

# 5. Hand the rest of /blog/ to the static files untouched. Apache's own
#    DirectorySlash adds the trailing slash; the rules below must not undo it.
RewriteCond %{REQUEST_URI} ^/blog/
RewriteRule ^ - [L]

# ============================================================================
# SITE — original rules, unchanged apart from the two /blog/ exclusions marked
# below. Base file: .htaccess-bk
# ============================================================================

# BEGIN Non WWW
RewriteCond %{HTTP_HOST} ^www.pixelstreet.in [NC]
RewriteRule ^(.*)$ https://pixelstreet.in/$1 [L,R=301]

RewriteCond %{REQUEST_URI} !^/blog/
RewriteCond %{THE_REQUEST} /([^.]+)\.html [NC]
RewriteRule ^ /%1 [NC,L,R]

RewriteCond %{REQUEST_URI} !^/blog/
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)/$ /$1 [L,R=301]


RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^ %{REQUEST_URI}.html [NC,L]
RewriteCond %{SERVER_PORT} 80
RewriteCond %{HTTP_HOST} ^(www\.)?pixelstreet\.in
RewriteRule ^(.*)$ https://pixelstreet.in/$1 [R,L]



<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType image/ico "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
  ExpiresByType video/mpeg "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType text/js "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType application/pdf "access plus 1 month"
  ExpiresByType application/x-shockwave-flash "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"
  ExpiresByType application/vnd.ms-fontobject "access plus 1 year"
</IfModule>


# BEGIN Caching
<ifModule mod_headers.c>
<filesMatch "\.(ico|pdf|flv|jpg|jpeg|png|gif|swf)$">
Header set Cache-Control "max-age=31536000, public"
Header unset ETag
FileETag None
</filesMatch>
<filesMatch "\.(css)$">
Header set Cache-Control "max-age=604800, public"
Header unset ETag
FileETag None
</filesMatch>
<filesMatch "\.(js)$">
Header set Cache-Control "max-age=31536000, private"
Header unset ETag
FileETag None
</filesMatch>
<filesMatch "\.(xml|txt)$">
Header set Cache-Control "max-age=216000, public, must-revalidate"
Header unset ETag
FileETag None
</filesMatch>
<filesMatch "\.(html|htm|php)$">
Header set Cache-Control "max-age=1, private, must-revalidate"
Header unset ETag
FileETag None
</filesMatch>
<filesMatch "\.(woff|woff2|ttf|eot|otf)$">
Header set Cache-Control "max-age=31536000, public"
Header unset ETag
FileETag None
</filesMatch>

</ifModule>
# END Caching

# BEGIN Security Headers
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=()"
Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
Header always set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.googletagmanager.com https://www.google.com https://www.gstatic.com https://cdnjs.cloudflare.com https://cdn.jsdelivr.net https://static.hotjar.com https://script.hotjar.com https://*.hotjar.com https://www.googleadservices.com https://ad.doubleclick.net; style-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://cdn.jsdelivr.net https://fonts.googleapis.com; img-src 'self' data: https:; font-src 'self' data: https://cdnjs.cloudflare.com https://fonts.gstatic.com; connect-src 'self' https://www.google-analytics.com https://analytics.google.com https://*.hotjar.com https://*.hotjar.io wss://*.hotjar.com https://www.googletagmanager.com https://www.google.com https://ad.doubleclick.net https://www.googleadservices.com; frame-src 'self' https://www.google.com https://*.hotjar.com https://td.doubleclick.net https://www.youtube.com; object-src 'none'; base-uri 'self'; frame-ancestors 'self'"
</IfModule>
# END Security Headers


<IfModule mod_deflate.c>
  # Compress HTML, CSS, JavaScript, Text, XML and fonts
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/rss+xml
  AddOutputFilterByType DEFLATE application/vnd.ms-fontobject
  AddOutputFilterByType DEFLATE application/x-font
  AddOutputFilterByType DEFLATE application/x-font-opentype
  AddOutputFilterByType DEFLATE application/x-font-otf
  AddOutputFilterByType DEFLATE application/x-font-truetype
  AddOutputFilterByType DEFLATE application/x-font-ttf
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE application/xhtml+xml
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE font/opentype
  AddOutputFilterByType DEFLATE font/otf
  AddOutputFilterByType DEFLATE font/ttf
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE image/x-icon
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/xml

  # Remove browser bugs (only needed for really old browsers)
  BrowserMatch ^Mozilla/4 gzip-only-text/html
  BrowserMatch ^Mozilla/4\.0[678] no-gzip
  BrowserMatch \bMSIE !no-gzip !gzip-only-text/html
  Header append Vary User-Agent
</IfModule>

Redirect 301 /branding-agency https://pixelstreet.in/branding-agency-kolkata
